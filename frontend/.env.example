# Copia este archivo a `.env` y ajusta el valor. `.env` no se versiona.
#
# Dirección del backend. Es sólo un RESPALDO: el inicio de sesión deduce la
# dirección del origen de la página, porque nginx sirve el punto de venta y la
# API desde el mismo sitio. Este valor únicamente se usa en desarrollo, donde el
# POS corre en un puerto y el backend en otro.
#
# Ojo: todo lo que empieza por EXPO_PUBLIC_ acaba dentro del paquete que se
# descarga el navegador. No pongas aquí nada que deba quedar en secreto.
EXPO_PUBLIC_MEDUSA_API_URL=http://localhost:9000

# Dónde vive el PANEL en desarrollo. Sólo se usa con __DEV__.
#
# El panel de `medusa develop` (puerto 9000) no carga en cuanto el proyecto
# tiene extensiones de admin: los archivos de src/admin se sirven por /@fs/ y
# esas peticiones devuelven el index.html en vez del módulo.
#
# No es cosa nuestra. Acotado: apartando src/admin el panel carga, y vuelve a
# fallar al devolver un solo widget que nadie ha tocado. El compilado sí va:
#
#     cd backend && npm run dev:panel
#
# En producción esto NO se usa: nginx sirve el panel en /app del mismo origen.
EXPO_PUBLIC_ADMIN_URL=http://localhost:4173
