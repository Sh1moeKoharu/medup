# ─────────────────────────────────────────────────────────────────────────────
# CORS — orígenes autorizados. En producción, SOLO tu dominio con https.
# ─────────────────────────────────────────────────────────────────────────────
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# ─────────────────────────────────────────────────────────────────────────────
# SECRETOS — genera cada uno con:  openssl rand -base64 48
#
# En producción el arranque FALLA si quedan en "supersecret" o vacíos. Un
# JWT_SECRET conocido permite forjar la sesión de cualquier usuario, incluido
# el administrador.
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=
COOKIE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://usuario:clave@localhost:5432/altus

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
#
# ⚠️ Si defines REDIS_URL, Redis DEBE estar corriendo: la aplicación ya no
#    degrada en silencio. Antes esta variable existía pero nadie la leía, así
#    que Medusa arrancaba con un bus de eventos en memoria mostrando
#    "Local Event Bus installed. This is not recommended for production".
#
#  · Desarrollo local SIN Redis  -> deja esta línea comentada.
#  · Desarrollo local CON Redis  -> descoméntala (recomendado: igual a producción).
#  · Producción                  -> OBLIGATORIA; el arranque falla sin ella.
#
# REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# MODO DE EJECUCIÓN
#
#   shared  Una instancia atiende API y ejecuta los jobs programados (por omisión).
#   server  Sólo API.
#   worker  Sólo jobs y workflows.
#
# ⚠️ Si separas en server + worker, DEBE existir una instancia en modo `worker`.
#    Los jobs `check-expirations` y `block-expired-batches` sólo corren ahí: una
#    instalación con puro `server` deja de bloquear lotes caducados sin avisar.
# ─────────────────────────────────────────────────────────────────────────────
MEDUSA_WORKER_MODE=shared

# ─────────────────────────────────────────────────────────────────────────────
# COOKIES SOBRE HTTP (sólo servidores de ensayo)
#
# En modo produccion Medusa marca la cookie de sesion como Secure, y el
# navegador se niega a guardarla sobre http://. Sintoma: el admin acepta el
# login y rebota a la pantalla de inicio sin mostrar error.
#
# ⚠️ NUNCA con datos reales: la cookie viajaria en claro. La solucion correcta
#    es poner TLS delante. Esta bandera es un puente mientras no hay certificado.
#
# ALLOW_INSECURE_COOKIES=1
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# DATOS PERSISTENTES
#
# `medusa build` BORRA y regenera .medusa/server en cada compilacion, y ahi es
# donde corre el servidor. Todo lo que se escriba relativo al directorio de
# trabajo se pierde al recompilar:
#
#   static/   imagenes de producto que la base referencia por URL
#   reports/  CSV de destruccion sanitaria
#
# Define una ruta FUERA del arbol de build. Sin esta variable se conserva el
# comportamiento anterior (relativo al cwd), util para desarrollo local.
#
# En el servidor:  sudo mkdir -p /var/lib/altus && sudo chown altus:altus /var/lib/altus
#
# ALTUS_DATA_DIR=/var/lib/altus

# URL publica del backend, usada para construir los enlaces de los archivos
# subidos. Por omision http://localhost:9000
# MEDUSA_BACKEND_URL=http://localhost:9000

# ─────────────────────────────────────────────────────────────────────────────
# ATAJO AL PUNTO DE VENTA
#
# El panel muestra en el menu una entrada "Punto de Venta" que lleva al POS,
# para que el cajero no tenga que teclear otra direccion.
#
# Con la configuracion de Nginx del repo, el POS se sirve en la raiz del mismo
# origen, asi que "/" es correcto. En desarrollo, donde el POS corre en otro
# puerto, apunta a esa direccion (por ejemplo http://localhost:8081).
#
# Se hornea en el build del panel: si cambia, hay que recompilar.
#
# ADMIN_POS_URL=/

# ─────────────────────────────────────────────────────────────────────────────
# IDIOMA DEL PANEL
#
# Por omision "es". Se siembra como preferencia inicial; quien lo cambie desde
# Ajustes conserva su eleccion.
#
# ADMIN_DEFAULT_LANGUAGE=es

# ─────────────────────────────────────────────────────────────────────────────
# NOTIFICACIONES (Resend)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_FROM=SIGH <no-reply@tudominio.mx>
