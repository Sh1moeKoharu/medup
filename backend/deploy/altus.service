# Servicio systemd del backend SIGH / Altus.
#
# NO hace falta copiar este archivo a mano. El instalador lo hace y ademas
# sustituye las rutas de ejemplo por las reales de la copia del repositorio:
#
#   sudo bash backend/deploy/instalar-servicios.sh
#
# Instalacion manual, si se prefiere (ajustando User y las rutas):
#   sudo cp backend/deploy/altus.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now altus

[Unit]
Description=SIGH Altus - Backend Medusa
After=network.target postgresql.service redis-server.service

# Wants y no Requires, a proposito.
#
# Con Requires, si PostgreSQL o Redis fallan o tardan, systemd DETIENE tambien
# el backend y lo deja parado. En un equipo que nadie vigila eso significa que
# la farmacia amanece sin sistema por un tropiezo momentaneo de un servicio
# vecino, y alguien tiene que ir a levantarlo a mano.
#
# Con Wants se pide que se levanten, pero si no estan listos el backend
# simplemente falla al arrancar y Restart=always lo reintenta hasta que si lo
# estan. El resultado es el mismo cuando todo va bien y se recupera solo
# cuando no.
Wants=postgresql.service redis-server.service

# Sin limite de reintentos.
#
# Por omision systemd se rinde tras unos pocos arranques fallidos seguidos y
# deja la unidad muerta hasta que alguien intervenga. Aqui no hay nadie que
# intervenga: es preferible que siga intentandolo indefinidamente.
StartLimitIntervalSec=0

[Service]
Type=simple
User=altus

# `medusa build` genera un directorio autonomo en .medusa/server y el servidor
# de produccion se ejecuta DESDE AHI, no desde la raiz del proyecto. Arrancar
# en la raiz falla con "Could not find index.html in the admin build directory".
WorkingDirectory=/home/altus/altus/backend/.medusa/server

# La configuracion vive FUERA del arbol de build: `medusa build` borra y
# regenera .medusa/ en cada compilacion, asi que un .env copiado ahi se pierde.
EnvironmentFile=/etc/altus/backend.env
Environment=NODE_ENV=production

# Recrea el enlace de `static` a la ruta persistente. Se ejecuta en CADA
# arranque a proposito: `medusa build` regenera .medusa/server y se lleva el
# enlace, asi que un despliegue que solo recompile y reinicie queda cubierto.
ExecStartPre=/bin/bash /home/altus/altus/backend/deploy/link-persistent-dirs.sh /home/altus/altus/backend/.medusa/server

ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
